import csv
import os
ARCHIVO = "paises.csv"
CAMPOS = ["nombre", "poblacion", "superficie", "continente"]
def validar_texto(mensaje):
    """Solicita un texto que contenga solamente letras y espacios."""
    while True:
        valor = input(mensaje).strip()
        if valor == "":
            print("Error: el campo no puede estar vacío.")
        elif not all(letra.isalpha() or letra == " "
                     for letra in valor):
            print("Error: solo se permiten letras.")
        else:
            return valor
def validar_entero(mensaje):
    """Solicita un número entero positivo utilizando isdigit()."""
    while True:
        valor = input(mensaje).strip()
        if valor == "":
            print("Error: el campo no puede estar vacío.")
        elif not valor.isdigit():
            print("Error: solo se permiten números enteros.")
        elif int(valor) <= 0:
            print("Error: el número debe ser mayor a cero.")
        else:
            return int(valor)
def cargar_paises():
    paises = []
    if not os.path.exists(ARCHIVO):
        guardar_paises(paises)
        return paises
    try:
        with open(ARCHIVO, "r", encoding="utf-8-sig",
                  newline="") as archivo:
            lector = csv.DictReader(archivo)
            if lector.fieldnames != CAMPOS:
                print("Error: encabezados incorrectos en el CSV.")
                return paises
            for numero, fila in enumerate(lector, start=2):
                try:
                    nombre = fila["nombre"].strip()
                    continente = fila["continente"].strip()
                    poblacion = fila["poblacion"].strip()
                    superficie = fila["superficie"].strip()
                    if not nombre or not continente:
                        raise ValueError("Hay campos vacíos.")
                    if not poblacion.isdigit():
                        raise ValueError("Población inválida.")
                    if not superficie.isdigit():
                        raise ValueError("Superficie inválida.")
                    poblacion = int(poblacion)
                    superficie = int(superficie)
                    if poblacion <= 0 or superficie <= 0:
                        raise ValueError("Los valores deben ser positivos.")
                    pais = {
                        "nombre": nombre,
                        "poblacion": poblacion,
                        "superficie": superficie,
                        "continente": continente
                    }
                    paises.append(pais)
                except (ValueError, TypeError, KeyError) as error:
                    print(f"Fila {numero} ignorada: {error}")
    except OSError as error:
        print(f"Error al leer el archivo: {error}")
    return paises
def guardar_paises(paises):
    try:
        with open(ARCHIVO, "w", encoding="utf-8",
                  newline="") as archivo:
            escritor = csv.DictWriter(
                archivo,
                fieldnames=CAMPOS
            )
            escritor.writeheader()
            escritor.writerows(paises)
        return True
    except OSError as error:
        print(f"Error al guardar el archivo: {error}")
        return False
def mostrar_paises(paises):
    if not paises:
        print("\nNo hay países para mostrar.")
        return
    print("\n" + "-" * 85)
    print(f"{'NOMBRE':<20} {'POBLACIÓN':>15} "
          f"{'SUPERFICIE':>15} {'CONTINENTE':<20}")
    print("-" * 85)
    for pais in paises:
        print(
            f"{pais['nombre']:<20} "
            f"{pais['poblacion']:>15,} "
            f"{pais['superficie']:>15,} "
            f"{pais['continente']:<20}"
        )
    print("-" * 85)
def agregar_pais(paises):
    print("\n--- AGREGAR PAÍS ---")
    nombre = validar_texto("Nombre: ")
    for pais in paises:
        if pais["nombre"].lower() == nombre.lower():
            print("Error: el país ya existe.")
            return
    poblacion = validar_entero("Población: ")
    superficie = validar_entero("Superficie en km²: ")
    continente = validar_texto("Continente: ")
    nuevo_pais = {
        "nombre": nombre,
        "poblacion": poblacion,
        "superficie": superficie,
        "continente": continente
    }
    paises.append(nuevo_pais)
    if guardar_paises(paises):
        print("País agregado correctamente.")
def actualizar_pais(paises):
    print("\n--- ACTUALIZAR PAÍS ---")
    nombre = validar_texto("Nombre del país: ")
    for pais in paises:
        if pais["nombre"].lower() == nombre.lower():
            print("País encontrado.")
            pais["poblacion"] = validar_entero(
                "Nueva población: "
            )
            pais["superficie"] = validar_entero(
                "Nueva superficie: "
            )
            if guardar_paises(paises):
                print("Datos actualizados correctamente.")
            return
    print("No se encontró el país.")
def buscar_pais(paises):
    print("\n--- BUSCAR PAÍS ---")
    nombre = validar_texto("Ingrese el nombre a buscar: ")
    resultados = [
        pais for pais in paises
        if nombre.lower() in pais["nombre"].lower()
    ]
    mostrar_paises(resultados)
def filtrar_continente(paises):
    print("\n--- FILTRAR POR CONTINENTE ---")
    continente = validar_texto("Ingrese el continente: ")
    resultados = [
        pais for pais in paises
        if pais["continente"].lower() == continente.lower()
    ]
    mostrar_paises(resultados)
def filtrar_rango(paises, campo):
    print(f"\n--- FILTRAR POR {campo.upper()} ---")
    minimo = validar_entero("Valor mínimo: ")
    maximo = validar_entero("Valor máximo: ")
    if minimo > maximo:
        print("Error: el mínimo no puede ser mayor al máximo.")
        return
    resultados = [
        pais for pais in paises
        if minimo <= pais[campo] <= maximo
    ]
    mostrar_paises(resultados)
def menu_filtros(paises):
    while True:
        print("\n--- FILTRAR PAÍSES ---")
        print("1. Por continente")
        print("2. Por rango de población")
        print("3. Por rango de superficie")
        print("0. Volver")
        opcion = input("Seleccione una opción: ").strip()
        if opcion == "1":
            filtrar_continente(paises)
        elif opcion == "2":
            filtrar_rango(paises, "poblacion")
        elif opcion == "3":
            filtrar_rango(paises, "superficie")
        elif opcion == "0":
            break
        else:
            print("Error: opción inválida.")
def ordenar_paises(paises):
    while True:
        print("\n--- ORDENAR PAÍSES ---")
        print("1. Por nombre")
        print("2. Por población")
        print("3. Por superficie")
        print("0. Volver")
        opcion = input("Seleccione una opción: ").strip()
        if opcion == "0":
            break
        if opcion not in ["1", "2", "3"]:
            print("Error: opción inválida.")
            continue
        if opcion == "1":
            campo = "nombre"
        elif opcion == "2":
            campo = "poblacion"
        else:
            campo = "superficie"
        if opcion == "1":
            ordenados = sorted(
                paises,
                key=lambda p: p[campo].lower()
            )
            mostrar_paises(ordenados)
        else:
            print("1. Ascendente")
            print("2. Descendente")
            sentido = input("Seleccione el orden: ").strip()
            if sentido not in ["1", "2"]:
                print("Error: orden inválido.")
                continue
            ordenados = sorted(
                paises,
                key=lambda p: p[campo],
                reverse=(sentido == "2")
            )
            mostrar_paises(ordenados)
def mostrar_estadisticas(paises):
    print("\n--- ESTADÍSTICAS ---")
    if not paises:
        print("No hay países cargados para calcular estadísticas.")
        return
    mayor = max(
        paises,
        key=lambda p: p["poblacion"]
    )
    menor = min(
        paises,
        key=lambda p: p["poblacion"]
    )
    promedio_poblacion = (
        sum(p["poblacion"] for p in paises) / len(paises)
    )
    promedio_superficie = (
        sum(p["superficie"] for p in paises) / len(paises)
    )
    print("\nPaís con mayor población:")
    print(mayor["nombre"], "-", f"{mayor['poblacion']:,}")
    print("\nPaís con menor población:")
    print(menor["nombre"], "-", f"{menor['poblacion']:,}")
    print("\nPromedio de población:")
    print(f"{promedio_poblacion:,.2f}")
    print("\nPromedio de superficie:")
    print(f"{promedio_superficie:,.2f} km²")
    cantidades = {}
    for pais in paises:
        continente = pais["continente"]
        if continente in cantidades:
            cantidades[continente] += 1
        else:
            cantidades[continente] = 1
    print("\nCantidad de países por continente:")
    for continente, cantidad in cantidades.items():
        print(f"{continente}: {cantidad}")
def menu_principal():
    paises = cargar_paises()
    while True:
        print("\nSISTEMA DE PAÍSES ")
        print("1. Agregar país")
        print("2. Actualizar país")
        print("3. Buscar país")
        print("4. Filtrar países")
        print("5. Ordenar países")
        print("6. Mostrar estadísticas")
        print("7. Mostrar todos los países")
        print("0. Salir")
        print(" ")
        opcion = input("Seleccione una opción: ").strip()
        if opcion == "1":
            agregar_pais(paises)
        elif opcion == "2":
            actualizar_pais(paises)
        elif opcion == "3":
            buscar_pais(paises)
        elif opcion == "4":
            menu_filtros(paises)
        elif opcion == "5":
            ordenar_paises(paises)
        elif opcion == "6":
            mostrar_estadisticas(paises)
        elif opcion == "7":
            mostrar_paises(paises)
        elif opcion == "0":
            print("Gracias por utilizar el sistema.")
            break
        else:
            print("Error: opción inválida. Intente nuevamente.")
if __name__ == "__main__":
    menu_principal()
